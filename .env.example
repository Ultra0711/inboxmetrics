# Copy this file to .env.local for local dev, and set the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# Never commit .env.local — it's already covered by the default Next.js .gitignore.

# From Neon / Supabase / Railway, after creating the hosted Postgres DB
DATABASE_URL=

# From Google Cloud Console → APIs & Services → Credentials (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From NextAuth setup — generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Any random string you make up yourself — used to verify Vercel Cron requests
CRON_SECRET=
